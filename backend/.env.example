# Copiar a .env y ajustar. Nunca subir .env al repositorio.
PORT=4000
NODE_ENV=development

# PostgreSQL (fuente central de verdad)
DATABASE_URL=postgres://postgres:CAMBIAR@127.0.0.1:5432/ferreteria_ai
# Base exclusiva para pruebas automatizadas: se borra y recrea en cada ejecución.
TEST_DATABASE_URL=postgres://postgres:CAMBIAR@127.0.0.1:5432/ferreteria_ai_test

# Autenticación (DP-01). Use un secreto aleatorio de 32+ caracteres.
JWT_SECRET=cambie-este-secreto-por-uno-aleatorio-de-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

# Ollama: solo el backend lo contacta. El modelo debe soportar tool calling (p. ej. qwen2.5:7b, llama3.1:8b).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=90000
AI_MAX_ITERATIONS=6
AI_MAX_TOOL_CALLS=10
AI_MAX_MESSAGE_CHARS=2000
AI_HISTORY_MESSAGES=12

# Frontend permitido por CORS
FRONTEND_URL=http://localhost:5173

# Límites de solicitudes (ventana en milisegundos)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_CHAT_MAX=20

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Negocio
COTIZACION_VIGENCIA_DIAS=15
CIERRE_AUTOMATICO=false
